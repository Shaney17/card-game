{
  "name": "chieu-bai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @chieu-bai/server --filter @chieu-bai/web dev",
